{
  "name": "math-word-wall-membership",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "dist", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "math-word-wall-members", "database_id": "REPLACE_AFTER_DATABASE_CREATION"}],
  "vars": {"SITE_URL": "https://REPLACE_WITH_YOUR_DOMAIN", "CLERK_PUBLISHABLE_KEY": "", "CLERK_ISSUER": "", "STRIPE_PRICE_ID": "", "PLAN_LABEL": "$12 / month", "OWNER_USER_ID": ""}
}
