// Automatic roster enrollment and student login build.
// Sandbox Worker: deploy with --config wrangler.test.jsonc.
// Classroom release: copyable codes, roster CSV uploads, and dedicated learner joining.
{
  "name": "math-word-wall-membership-test",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
